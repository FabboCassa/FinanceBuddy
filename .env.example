# FinanceBuddy environment template — copy to .env and fill in real values.
# .env is gitignored; THIS file (.env.example) is committed with placeholders only.

# --- Django ---
DEBUG=True
# Generate a strong one: python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (must match the values the Postgres volume was created with) ---
DB_NAME=finance_buddy
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- NLP ---
USE_REAL_NLP=False

# --- Sentiment alert thresholds (optional; defaults in core/constants.py) ---
# SENTIMENT_ALERT_LOW=-0.6
# SENTIMENT_ALERT_HIGH=0.6

# --- Alert channels (all optional; leave empty to disable that channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=
