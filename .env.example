# FinanceBuddy environment template — copy to .env and fill in real values.
# .env is gitignored; THIS file (.env.example) is committed with placeholders only.

# --- Django ---
# Dev machine: True. Server: False (also the default if unset).
DEBUG=True
# REQUIRED when DEBUG=False. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
# Server only (comma-separated). E.g. your Tailscale MagicDNS name:
# ALLOWED_HOSTS=fb-vm.tailnet-xyz.ts.net,localhost
# Needed for HTTPS via `tailscale serve`:
# CSRF_TRUSTED_ORIGINS=https://fb-vm.tailnet-xyz.ts.net
# Set True only when the app is reached over HTTPS exclusively:
# SECURE_COOKIES=True

# --- Database (must match the values the Postgres volume was created with) ---
# DB_PASSWORD is REQUIRED (compose refuses to start without it). Generate:
#   openssl rand -base64 24
DB_NAME=finance_buddy
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- NLP ---
USE_REAL_NLP=False
# Zero-shot NLI theme categorization (Phase 4 rung 2). Downloads facebook/bart-large-mnli
# (~1.6GB) on first use; when False, the keyword cold-start classifier is used instead.
USE_ZERO_SHOT_NLP=False

# --- News sources (Phase 4) ---
# Pull news from curated quality RSS feeds (Bloomberg/FT/Il Sole 24 Ore/Nikkei/…),
# linked to tracked assets via entity linking. Set False to rely on yfinance only.
RSS_INGEST_ENABLED=True
# With a large (~500) universe, cap how many assets get yfinance per-ticker news
# per cycle (the rest are covered by RSS + NER). 0 disables per-ticker news.
YFINANCE_NEWS_MAX_ASSETS=40

# --- Sentiment alert thresholds (optional; defaults in core/constants.py) ---
# SENTIMENT_ALERT_LOW=-0.6
# SENTIMENT_ALERT_HIGH=0.6

# --- Alert channels (all optional; leave empty to disable that channel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=
